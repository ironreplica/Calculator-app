# Stage 1: Build — uses the grupoavispa image which has oatpp 1.3.0 pre-installed
FROM grupoavispa/oatpp:1.3.0-jammy AS builder

WORKDIR /app
COPY . .

RUN mkdir -p build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc)

# Stage 2: Runtime — lean Ubuntu image, just copy the compiled binary
FROM ubuntu:jammy

WORKDIR /app
COPY --from=builder /app/build/my-oatpp-app .

EXPOSE 8000
CMD ["./my-oatpp-app"]